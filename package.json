{
  "name": "todo-fullstack-app",
  "version": "1.0.0",
  "description": "Simple full stack To-Do list application with authentication",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "backend": "nodemon --watch server --ext js,json server/server.js",
    "frontend": "cd frontend && npm start",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build": "cd frontend && npm run build",
    "heroku-postbuild": "cd frontend && npm install && npm run build"
  },
  "keywords": [
    "todo",
    "express",
    "mongodb",
    "fullstack"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "concurrently": "^7.6.0"
  }
}
